NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=sportconnect
DB_USER=root
DB_PASSWORD=root

JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=7d

# Opcional — envio de email para recuperação de password. Se não forem
# definidas, o servidor usa automaticamente uma conta de teste Ethereal
# (o link de pré-visualização do email aparece na consola).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
